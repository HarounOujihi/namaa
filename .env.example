# Copy to apps/api/.env for the API
# Host ports 5432/9000/9001 are taken by other projects on this machine —
# dev infra (docker-compose.yml) maps postgres to 5435 and MinIO to 9005/9006.
DATABASE_URL=postgresql://dyslexia:dyslexia@localhost:5435/dyslexia?schema=public
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
S3_ENDPOINT=http://localhost:9005
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dyslexia-assets
PORT=3000
